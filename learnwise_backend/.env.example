# ============================================================================
# Learnwise Backend - .env.example
# Copiez ce fichier vers .env et remplissez les valeurs reelles.
# Tous les services IA utilises ici ont un niveau gratuit (sans carte bancaire).
# ============================================================================

# Django
DEBUG=True
SECRET_KEY=changez-moi-en-production
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (origine du frontend Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Base de données (SQLite par défaut, aucun paquet supplémentaire nécessaire)
DB_CONNECTION=sqlite

# Email (console par défaut pour le développement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=http://localhost:5173

# 2FA / TOTP
REQUIRE_ADMIN_2FA=False

# Face recognition (seuil de distance euclidienne, plus bas = plus strict)
FACE_MATCH_THRESHOLD=0.5

# --------------------------------------------------------------------------
# IA - Gemini (Google) : niveau gratuit disponible sans carte bancaire
# Obtenez une cle sur https://aistudio.google.com/app/apikey
# --------------------------------------------------------------------------
GEMINI_API_KEY=votre_cle_gemini_ici
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --------------------------------------------------------------------------
# IA - Hugging Face Inference API : niveau gratuit (quelques centaines de requetes/jour)
# Obtenez un token sur https://huggingface.co/settings/tokens
# --------------------------------------------------------------------------
HF_API_TOKEN=votre_token_hf_ici
HF_WHISPER_MODEL=openai/whisper-large-v3
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Fournisseurs IA (ordre de tentative)
IMAGE_PROVIDERS=huggingface,gemini
TRANSCRIPTION_PROVIDERS=huggingface,gemini

# Redis (requis en production pour la protection contre le rejeu TOTP ; optionnel en dev)
# REDIS_URL=redis://localhost:6379/0
